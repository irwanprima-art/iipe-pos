# ============================================================
# IIPE — template environment (dibaca otomatis oleh docker compose)
# Salin file ini menjadi .env lalu isi nilai rahasia Anda.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=iipe
POSTGRES_PASSWORD=iipe
POSTGRES_DB=iipe
DB_PORT=55432

# --- Backend / umum ---
JWT_SECRET=change-me
BACKEND_PORT=8080
FRONTEND_PORT=8090
MOCK_PAYMENTS=true
AFFILIATE_CODE=iipe-affiliate
# URL publik aplikasi (dipakai untuk redirect SumoPay: /payment/result?token=...)
APP_BASE_URL=https://bazzar.souluze.com

# --- Notifikasi WhatsApp via n8n ---
N8N_WEBHOOK_URL=

# --- Payment SumoPay (sandbox) ---
# Aktifkan: set MOCK_PAYMENTS=false dan isi SUMO_API_KEY (sandbox/produksi).
SUMO_API_URL=https://api-pay-sandbox.sumopod.com
SUMO_API_KEY=
SUMO_WEBHOOK_SECRET=
SUMO_WEBHOOK_TOKEN=

# --- S3 / CloudEka box (kosongkan = simpan gambar lokal) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=https://kencana.basic.box.cloudeka.id
S3_SECURE=true
MAX_IMAGE_DIM=1200

# Untuk pengembangan backend lokal (go run ./cmd/server) tanpa Docker,
# gunakan:  $env:DATABASE_URL="postgres://iipe:iipe@localhost:5432/iipe?sslmode=disable"
